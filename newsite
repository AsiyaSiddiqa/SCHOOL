<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Al-Madina Kiryana Store</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50">

    <!-- Top Announcement Bar -->
    <div class="bg-emerald-800 text-white text-xs sm:text-sm py-2 px-4 flex justify-between items-center">
        <p>Welcome to Al-Madina Kiryana Store</p>
        <div class="flex items-center space-x-4">
            <span>📞 +92 300 1234567</span>
            <span class="hidden sm:inline">Home Delivery Available</span>
        </div>
    </div>

    <!-- Main Navbar -->
    <header class="bg-white shadow-md sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 py-3 flex items-center justify-between">
            
            <!-- Logo / Store Name -->
            <div class="flex items-center space-x-2">
                <div class="bg-emerald-600 text-white font-bold p-2 rounded-lg text-lg">
                    🛒
                </div>
                <div>
                    <h1 class="text-xl font-bold text-gray-800 leading-tight">Al-Madina</h1>
                    <span class="text-xs text-emerald-600 font-semibold tracking-wider">KIRYANA</span>
                </div>
            </div>

            <!-- Search Bar (Hidden on small screens, visible on md and above) -->
            <div class="hidden md:flex items-center flex-1 max-w-md mx-8">
                <div class="relative w-full">
                    <input type="text" placeholder="Search for aata, daal, oil, etc..." 
                        class="w-full bg-gray-100 border border-gray-300 rounded-lg py-2 pl-4 pr-10 text-sm focus:outline-none focus:border-emerald-600">
                    <button class="absolute right-2 top-2 text-emerald-600 font-bold px-2">
                        🔍
                    </button>
                </div>
            </div>

            <!-- Right Actions (User Account & Cart) -->
            <div class="flex items-center space-x-6">
                <!-- User Account -->
                <a href="#" class="hidden sm:flex items-center space-x-1 text-gray-700 hover:text-emerald-600 text-sm font-medium">
                    <span>👤</span>
                    <span>Account</span>
                </a>

                <!-- Shopping Cart -->
                <a href="#" class="relative flex items-center text-gray-700 hover:text-emerald-600">
                    <span class="text-2xl">🛍️</span>
                    <!-- Cart Badge Count -->
                    <span class="absolute -top-2 -right-2 bg-emerald-600 text-white text-xs font-bold rounded-full h-5 w-5 flex items-center justify-center">
                        0
                    </span>
                </a>
            </div>

        </div>

        <!-- Mobile Search Bar (Visible only on small screens) -->
        <div class="block md:hidden px-4 pb-3">
            <div class="relative w-full">
                <input type="text" placeholder="Search products..." 
                    class="w-full bg-gray-100 border border-gray-300 rounded-lg py-2 pl-4 pr-10 text-sm focus:outline-none focus:border-emerald-600">
                <button class="absolute right-2 top-2 text-emerald-600 font-bold px-2">
                    🔍
                </button>
            </div>
        </div>

        <!-- Navigation Links Menu -->
        <nav class="bg-gray-100 border-t border-gray-200">
            <div class="max-w-7xl mx-auto px-4 flex space-x-6 overflow-x-auto py-2 text-sm font-medium text-gray-700">
                <a href="#" class="text-emerald-600 font-semibold whitespace-nowrap">Home</a>
                <a href="#" class="hover:text-emerald-600 whitespace-nowrap">Groceries</a>
                <a href="#" class="hover:text-emerald-600 whitespace-nowrap">Household</a>
                <a href="#" class="hover:text-emerald-600 whitespace-nowrap">Personal Care</a>
                <a href="#" class="hover:text-emerald-600 whitespace-nowrap">Special Offers</a>
                <a href="#" class="hover:text-emerald-600 whitespace-nowrap">Contact Us</a>
            </div>
        </nav>
    </header>

</body>
</html>